        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    CUSTOMER {\n        int customer_id PK\n        string name\n        string email\n        string phone\n    }\n    ORGANIZER {\n        int organizer_id PK\n        string name\n        string email\n    }\n    EVENT {\n        int event_id PK\n        string title\n        string description\n    }\n    EVENT_CATEGORY {\n        int category_id PK\n        string category_name\n    }\n    PERFORMANCE {\n        int performance_id PK\n        datetime start_time\n        datetime end_time\n    }\n    VENUE {\n        int venue_id PK\n        string name\n        string address\n    }\n    SEAT {\n        int venue_id PK,FK\n        int seat_number PK\n        int row_number\n        boolean is_available\n    }\n    BOOKING {\n        int booking_id PK\n        datetime booking_date\n        string status\n    }\n    TICKET {\n        int ticket_id PK\n        decimal price\n        string status\n    }\n    PAYMENT {\n        int payment_id PK\n        decimal amount\n        datetime payment_date\n        string status\n    }\n    STAFF {\n        int staff_id PK\n        string name\n        string email\n    }\n    VENUE_MANAGER {\n        int staff_id PK,FK\n        date assigned_date\n    }\n    CHECKIN_STAFF {\n        int staff_id PK,FK\n        string shift\n    }\n    CHECKIN {\n        int checkin_id PK\n        datetime checkin_time\n    }\n    TICKET_TYPE {\n        int type_id PK\n        string type_name\n        string description\n    }\n\n    ORGANIZER ||--o{ EVENT : creates\n    EVENT_CATEGORY ||--o{ EVENT : classifies\n    EVENT ||--o{ PERFORMANCE : has\n    VENUE ||--o{ PERFORMANCE : hosts\n    VENUE ||--|{ SEAT : contains\n    CUSTOMER ||--o{ BOOKING : makes\n    BOOKING ||--o{ TICKET : contains\n    BOOKING ||--o{ PAYMENT : has\n    PERFORMANCE ||--o{ BOOKING : receives\n    PERFORMANCE ||--o{ TICKET : has\n    SEAT ||--o{ TICKET : assigned_to\n    TICKET_TYPE ||--o{ TICKET : classifies\n    TICKET ||--o| CHECKIN : has\n    CHECKIN_STAFF ||--o{ CHECKIN : records\n    STAFF o|--o{ STAFF : supervises\n    VENUE_MANAGER ||--o{ VENUE : manages\n    PERFORMANCE }o--|{ TICKET_TYPE : \&quot;offers (price)\&quot;\n    CHECKIN_STAFF }o--o{ PERFORMANCE : \&quot;assigned to (assigned_at)\&quot;\n    STAFF ||--o| VENUE_MANAGER : specializes\n    STAFF ||--o| CHECKIN_STAFF : specializes\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="SWzEcyqmagRBLzzMWUvI-1">
